# Скопируйте в .env и заполните
DATABASE_URL=postgres://outside:ПАРОЛЬ_БД@localhost:5432/outside
JWT_SECRET=замените_на_длинную_случайную_строку
PORT=3000
# SMTP для писем с кодами (пусто = коды печатаются в лог, режим разработки)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Outside <noreply@example.com>"
CONFIRM_THRESHOLD=30
